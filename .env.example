# ==============================================================================
# AutoTele SaaS - Production Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in the production secrets.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_random_password_32_chars
POSTGRES_DB=ad_exchange
DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@postgres_db:5432/ad_exchange

# ------------------------------------------------------------------------------
# 2. Cache & Message Broker (Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis_cache:6379/0

# ------------------------------------------------------------------------------
# 3. Cryptography & Security Secrets
# ------------------------------------------------------------------------------
# JWT Secret for FastAPI access tokens (Must be >= 32 random characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_strong_jwt_secret_min_32_chars

# Fernet symmetric encryption key for Telegram session strings in PostgreSQL
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=replace_with_base64_fernet_key_from_command_above

# ------------------------------------------------------------------------------
# 4. CORS & Frontend Origin Restriction
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (NO wildcards in production)
CORS_ALLOWED_ORIGINS=https://telegauto.com,https://www.telegauto.com,https://teleauto.com,https://www.teleauto.com
FRONTEND_URL=https://telegauto.com

# ------------------------------------------------------------------------------
# 5. Telegram Integration (Optional Central Bot & Defaults)
# ------------------------------------------------------------------------------
STATUS_BOT_TOKEN=
STATUS_BOT_USERNAME=AutoTeleStatusBot
TELEGRAM_DEFAULT_API_ID=
TELEGRAM_DEFAULT_API_HASH=

# ------------------------------------------------------------------------------
# 6. Payment & Crypto Verification (USDT TRC-20)
# ------------------------------------------------------------------------------
USDT_TRC20_WALLET=THzDfdWiUp7j7ESv4Z3V7MKvNra1gZVRup
TRONGRID_API_KEY=

# ------------------------------------------------------------------------------
# 7. SOCKS5 Proxy Pool (Optional Load Balancing)
# ------------------------------------------------------------------------------
# JSON array of proxy host IPs (leave empty "[]" for direct server connection)
PROXY_POOL=[]
DEFAULT_PROXY_PORT=50101
DEFAULT_PROXY_USERNAME=
DEFAULT_PROXY_PASSWORD=

# ------------------------------------------------------------------------------
# 8. Google OAuth (Optional Social Login)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
